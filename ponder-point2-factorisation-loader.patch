@@ -0,0 +1,29 @@
+<?php
+
+/**
+ * Chargeur unique des classes du plugin ScenarioForm.
+ *
+ * L'autoload Jeedom peut ne pas encore connaître les classes du plugin
+ * (installation fraîche, mise à jour des fichiers, premier affichage),
+ * ce qui provoquait notamment « scenarioformRequest not found ».
+ * Ce fichier centralise la liste des classes, utilisée à la fois par
+ * l'entrée AJAX et par les hooks d'installation.
+ */
+if (!function_exists('scenarioform_load_plugin_classes')) {
+    function scenarioform_load_plugin_classes(): void
+    {
+        $classDirectory = dirname(__FILE__) . '/../class/';
+        foreach ([
+            'scenarioformRequest',
+            'scenarioformRequestScenario',
+            'scenarioformForm',
+            'scenarioformFormScenario',
+            'scenarioformField',
+            'scenarioformResponse',
+            'scenarioformResponseValue',
+            'scenarioform'
+        ] as $className) {
+            require_once $classDirectory . $className . '.class.php';
+        }
+    }
+}
